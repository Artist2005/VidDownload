# Bot token from @BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# (Optional) Chat ID or private channel ID for temporary inline video uploads.
# If left empty, the bot automatically saves your chat_id when you send /start in a private message.
STORAGE_CHAT_ID=

# (Optional) Comma-separated admin user IDs for /update and cookies.txt uploads
ADMIN_IDS=

# (Optional) Maximum concurrent download/ffmpeg jobs (default: 2)
MAX_CONCURRENT_JOBS=2
